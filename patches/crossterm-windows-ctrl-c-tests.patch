+fn console_character_record(
+    virtual_key_code: u16,
+    character: char,
+    control_key_state: u32,
+    key_down: i32,
+) -> KeyEventRecord {
+    // INPUT_RECORD contains only integers and unions of integer records.
+    let mut record: INPUT_RECORD = unsafe { std::mem::zeroed() };
+    record.EventType = KEY_EVENT;
+    unsafe {
+        let key = record.Event.KeyEvent_mut();
+        key.bKeyDown = key_down;
+        key.wRepeatCount = 1;
+        key.wVirtualKeyCode = virtual_key_code;
+        *key.uChar.UnicodeChar_mut() = character as u16;
+        key.dwControlKeyState = control_key_state;
+    }
+    let InputRecord::KeyEvent(key) = InputRecord::from(record) else {
+        panic!("expected a key input record");
+    };
+    key
+}
+
+#[test]
+fn preserves_ctrl_c_from_console_records() {
+    // VK_C matches captured Armenian and Cyrillic input. VK=0 also covers
+    // synthesized console input and makes the regression independent of the
+    // keyboard layouts installed on the machine running this test.
+    for virtual_key_code in [0, 0x43] {
+        for control in [LEFT_CTRL_PRESSED, RIGHT_CTRL_PRESSED] {
+            for (extra_state, modifiers) in [
+                (0, KeyModifiers::CONTROL),
+                (CAPSLOCK_ON, KeyModifiers::CONTROL),
+                (SHIFT_PRESSED, KeyModifiers::CONTROL | KeyModifiers::SHIFT),
+                (
+                    SHIFT_PRESSED | CAPSLOCK_ON,
+                    KeyModifiers::CONTROL | KeyModifiers::SHIFT,
+                ),
+            ] {
+                for (key_down, kind) in [(1, KeyEventKind::Press), (0, KeyEventKind::Release)] {
+                    let key = console_character_record(
+                        virtual_key_code,
+                        '\u{3}',
+                        control | extra_state,
+                        key_down,
+                    );
+                    assert_eq!(
+                        handle_key_event(key, &mut None),
+                        Some(Event::Key(KeyEvent::new_with_kind(
+                            KeyCode::Char('c'),
+                            modifiers,
+                            kind,
+                        ))),
+                        "virtual key {virtual_key_code}, state {}, key down {key_down}",
+                        control | extra_state,
+                    );
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn preserves_literal_characters_with_control_and_alt_modifiers() {
+    for character in ['c', '\u{441}', '\u{581}'] {
+        for (control_key_state, modifiers) in [
+            (0, KeyModifiers::NONE),
+            (LEFT_CTRL_PRESSED, KeyModifiers::CONTROL),
+            (
+                LEFT_CTRL_PRESSED | RIGHT_ALT_PRESSED,
+                KeyModifiers::CONTROL | KeyModifiers::ALT,
+            ),
+        ] {
+            for (key_down, kind) in [(1, KeyEventKind::Press), (0, KeyEventKind::Release)] {
+                let key = console_character_record(0x43, character, control_key_state, key_down);
+                assert_eq!(
+                    handle_key_event(key, &mut None),
+                    Some(Event::Key(KeyEvent::new_with_kind(
+                        KeyCode::Char(character),
+                        modifiers,
+                        kind,
+                    ))),
+                    "literal {character:?}, state {control_key_state}, key down {key_down}",
+                );
+            }
+        }
+    }
+}
+
+#[test]
+fn does_not_reinterpret_etx_without_control_or_with_alt() {
+    for control_key_state in [
+        0,
+        LEFT_ALT_PRESSED,
+        RIGHT_ALT_PRESSED,
+        LEFT_CTRL_PRESSED | RIGHT_ALT_PRESSED,
+        RIGHT_CTRL_PRESSED | LEFT_ALT_PRESSED,
+    ] {
+        // With no virtual key, the old layout-lookup path has no character.
+        // In particular, AltGr must not enter the new Ctrl+C shortcut path.
+        let key = console_character_record(0, '\u{3}', control_key_state, 1);
+        assert_eq!(
+            handle_key_event(key, &mut None),
+            None,
+            "state {control_key_state}",
+        );
+    }
+}
